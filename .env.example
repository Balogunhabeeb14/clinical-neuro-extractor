# Directory where ingest.py's batch job writes df_*.csv snapshots.
# The app uses the most recent one as its default data source.
REGISTRY_RAW_DATA_DIR=/home/habeebb/Neuropsychology_Dept/Datapipeline/extract/raw_data

# Directory containing cs_core_v1.py (the existing CogStack cohort-searcher
# client used by ingest.py). Needed only for the live-refresh fallback.
COGSTACK_UTIL_PATH=/home/habeebb/Neuropsychology_Dept/util

# Optional overrides - default to the same values ingest.py uses.
COGSTACK_INDEX=epr_documents
COGSTACK_SEARCH_STRING=document_description:("Neuropsychology" AND ("report" OR "scores" OR "assessment"))

# Salt for the de-identified registry view's hashed patient IDs. Set a real
# private value in production - do not reuse this placeholder.
REGISTRY_SALT=change-me

# Flask session secret. Set a real random value in production.
FLASK_SECRET_KEY=change-me
